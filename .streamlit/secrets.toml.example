# 复制成 secrets.toml 后填入自己的 Key（secrets.toml 不进 git）
DEEPSEEK_API_KEY = "sk-..."

# 离线评审专用（只给 scripts/ 用，线上不调用）
# 没有这一段也能跑，会自动退回 DeepSeek 评审
# JUDGE_API_KEY  = "sk-..."
# JUDGE_BASE_URL = "https://api.moonshot.cn/v1"
# JUDGE_MODEL    = "kimi-k2-0905-preview"

# 温度（0–2）：只建议调 TEMP_QUESTION，其余保持 0 保证可复现
# TEMP_QUESTION  = "0.7"
# TEMP_INTERVIEW = "0.7"
